+/// Diagnostics added for the MATSU Editor PoC (patches/gpui-pre-windows-atlas-diag.diff).
+///
+/// Writes each atlas texture and each upload to `atlas-<process ID>.txt` in the current
+/// directory, with the process's private bytes (`PrivateUsage`) right before and right after
+/// the call. `POC_ATLAS_UPLOAD` picks the call that uploads a tile, and `POC_ATLAS_LOG=0`
+/// turns the measuring and the file off, to compare the calls without their cost.
+mod diag {
+    use super::{AtlasTextureId, Bounds, DevicePixels, Size};
+    use std::fmt::Arguments;
+    use std::io::Write as _;
+    use std::sync::atomic::{AtomicI64, AtomicU32, Ordering};
+    use std::sync::{Mutex, OnceLock};
+    use std::time::Instant;
+    use windows::Win32::Graphics::Dxgi::Common::{
+        DXGI_FORMAT, DXGI_FORMAT_B8G8R8A8_UNORM, DXGI_FORMAT_R8_UNORM, DXGI_FORMAT_R8G8B8A8_UNORM,
+    };
+    use windows::Win32::System::ProcessStatus::{
+        K32GetProcessMemoryInfo, PROCESS_MEMORY_COUNTERS, PROCESS_MEMORY_COUNTERS_EX,
+    };
+    use windows::Win32::System::Threading::GetCurrentProcess;
+
+    #[derive(Clone, Copy, Debug, PartialEq)]
+    pub(super) enum Method {
+        /// What GPUI does: `UpdateSubresource`. `POC_ATLAS_UPLOAD` unset.
+        UpdateSubresource,
+        /// `ID3D11DeviceContext1::UpdateSubresource1` with `D3D11_COPY_NO_OVERWRITE`.
+        /// `POC_ATLAS_UPLOAD=update1`.
+        UpdateSubresource1NoOverwrite,
+        /// `UpdateSubresource`, then `Flush`. `POC_ATLAS_UPLOAD=flush`.
+        UpdateSubresourceThenFlush,
+    }
+
+    fn enabled() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var("POC_ATLAS_LOG").as_deref() != Ok("0"))
+    }
+
+    pub(super) fn method() -> Method {
+        static METHOD: OnceLock<Method> = OnceLock::new();
+        *METHOD.get_or_init(|| {
+            let method = match std::env::var("POC_ATLAS_UPLOAD").as_deref() {
+                Ok("update1") => Method::UpdateSubresource1NoOverwrite,
+                Ok("flush") => Method::UpdateSubresourceThenFlush,
+                _ => Method::UpdateSubresource,
+            };
+            log(format_args!("upload method: {method:?}"));
+            method
+        })
+    }
+
+    /// The process's private bytes, or `None` when the measuring is off or fails.
+    pub(super) fn private_bytes() -> Option<i64> {
+        if !enabled() {
+            return None;
+        }
+        let mut counters = PROCESS_MEMORY_COUNTERS_EX {
+            cb: size_of::<PROCESS_MEMORY_COUNTERS_EX>() as u32,
+            ..Default::default()
+        };
+        let ok = unsafe {
+            K32GetProcessMemoryInfo(
+                GetCurrentProcess(),
+                (&raw mut counters).cast::<PROCESS_MEMORY_COUNTERS>(),
+                counters.cb,
+            )
+        };
+        ok.as_bool().then_some(counters.PrivateUsage as i64)
+    }
+
+    pub(super) fn log_texture(
+        id: AtlasTextureId,
+        size: Size<DevicePixels>,
+        format: DXGI_FORMAT,
+        bytes_per_pixel: u32,
+        before: Option<i64>,
+        after: Option<i64>,
+    ) {
+        if !enabled() {
+            return;
+        }
+        let format = match format {
+            DXGI_FORMAT_R8_UNORM => "R8_UNORM",
+            DXGI_FORMAT_B8G8R8A8_UNORM => "B8G8R8A8_UNORM",
+            DXGI_FORMAT_R8G8B8A8_UNORM => "R8G8B8A8_UNORM",
+            _ => "other format",
+        };
+        let texture_bytes = size.width.0 as i64 * size.height.0 as i64 * bytes_per_pixel as i64;
+        log(format_args!(
+            "texture {:?}[{}] created: {}x{} {format}, {} KiB; private {} -> {} MB ({} KiB)",
+            id.kind,
+            id.index,
+            size.width.0,
+            size.height.0,
+            texture_bytes / 1024,
+            show_mb(before),
+            show_mb(after),
+            show_kib(change(before, after)),
+        ));
+    }
+
+    pub(super) fn log_upload(
+        id: AtlasTextureId,
+        bounds: Bounds<DevicePixels>,
+        api: &str,
+        before: Option<i64>,
+        after: Option<i64>,
+    ) {
+        static COUNT: AtomicU32 = AtomicU32::new(0);
+        static SUM: AtomicI64 = AtomicI64::new(0);
+        static UNKNOWN: AtomicU32 = AtomicU32::new(0);
+        if !enabled() {
+            return;
+        }
+        let count = COUNT.fetch_add(1, Ordering::Relaxed) + 1;
+        let delta = change(before, after);
+        let sum = SUM.fetch_add(delta.unwrap_or(0), Ordering::Relaxed) + delta.unwrap_or(0);
+        let unknowns = UNKNOWN.fetch_add(delta.is_none() as u32, Ordering::Relaxed)
+            + delta.is_none() as u32;
+        // A sum that leaves out an unknown change is not the whole sum, so say so.
+        let unknown = if unknowns > 0 {
+            format!(" without {unknowns} unknown")
+        } else {
+            String::new()
+        };
+        log(format_args!(
+            "upload {count} to {:?}[{}] with {api}: {}x{} at ({}, {}); \
+             private {} -> {} MB ({} KiB, sum {} MB{unknown})",
+            id.kind,
+            id.index,
+            bounds.size.width.0,
+            bounds.size.height.0,
+            bounds.origin.x.0,
+            bounds.origin.y.0,
+            show_mb(before),
+            show_mb(after),
+            show_kib(delta),
+            show_mb(Some(sum)),
+        ));
+    }
+
+    /// Appends a line, with the seconds since the first line.
+    pub(super) fn log(line: Arguments) {
+        static FILE: Mutex<Option<std::fs::File>> = Mutex::new(None);
+        static START: OnceLock<Instant> = OnceLock::new();
+        if !enabled() {
+            return;
+        }
+        let start = *START.get_or_init(Instant::now);
+        let mut file = FILE.lock().unwrap_or_else(|error| error.into_inner());
+        if file.is_none() {
+            let path = format!("atlas-{}.txt", std::process::id());
+            match std::fs::File::create(&path) {
+                Ok(created) => *file = Some(created),
+                Err(error) => eprintln!("atlas log: cannot create {path}: {error}"),
+            }
+        }
+        if let Some(file) = file.as_mut()
+            && let Err(error) = writeln!(file, "{:8.3} s  {line}", start.elapsed().as_secs_f64())
+        {
+            eprintln!("atlas log: cannot write: {error}");
+        }
+    }
+
+    fn change(before: Option<i64>, after: Option<i64>) -> Option<i64> {
+        Some(after? - before?)
+    }
+
+    fn show_mb(bytes: Option<i64>) -> String {
+        bytes.map_or_else(|| "?".to_string(), |bytes| format!("{:.1}", bytes as f64 / 1048576.0))
+    }
+
+    fn show_kib(bytes: Option<i64>) -> String {
+        bytes.map_or_else(|| "?".to_string(), |bytes| format!("{:+}", bytes / 1024))
+    }
+}
