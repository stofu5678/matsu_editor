diff -ru a/src/gpui_windows.rs b/src/gpui_windows.rs
--- a/src/gpui_windows.rs	2026-10-14 06:17:00.706030671 +0900
+++ b/src/gpui_windows.rs	2026-10-14 06:17:00.853480546 +0900
@@ -1,5 +1,24 @@
 #![cfg(target_os = "windows")]
 
+fn thread_cpu_ms() -> (f64, f64) {
+    use windows::Win32::{Foundation::FILETIME, System::Threading::*};
+    let (mut a, mut b, mut k, mut u) = (FILETIME::default(), FILETIME::default(), FILETIME::default(), FILETIME::default());
+    unsafe { let _ = GetThreadTimes(GetCurrentThread(), &mut a, &mut b, &mut k, &mut u); }
+    let f = |t: FILETIME| ((t.dwHighDateTime as u64) << 32 | t.dwLowDateTime as u64) as f64 / 10_000.;
+    (f(u), f(k))
+}
+macro_rules! tm {
+    ($l:expr, $e:expr) => {{
+        let t = std::time::Instant::now();
+        let (u0, k0) = crate::thread_cpu_ms();
+        let r = $e;
+        if std::env::var_os("POC_TRACE_STARTUP").is_some() {
+            let (u1, k1) = crate::thread_cpu_ms();
+            eprintln!("    [gpui] {:7.1} ms  (cpu user {:5.1} kernel {:5.1})  {}", t.elapsed().as_secs_f64() * 1000., u1 - u0, k1 - k0, $l);
+        }
+        r
+    }};
+}
 mod clipboard;
 mod destination_list;
 mod dialog;
