; Sample plugin for the jack Outline (ADR-0026, PR 7). Its handler runs on the QuickJS of matsu-script.
; Put the folder HelloOutline in the folder "plugins" next to matsu.ini, add and enable it in
; 共通設定 > プラグイン. Then choose "Markdown headings (sample)" as the outline of a type in
; タイプ別設定 > スクリーン > アウトライン解析方法, and open the outline (アウトライン解析).
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.outline
Name=Outline (JavaScript)
Description=Lists the lines that start with # as a tree by the number of #.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
Outline=outline.js
Outline.Label=Markdown headings (sample)
