; Sample plugin whose handlers run on the user's Emacs (ADR-0026, PR 10): a command, an event, and
; the jacks Outline, Complement and SmartIndent. Put the folder HelloEmacsLisp in the folder "plugins"
; next to matsu.ini, then use Common settings > Plugin > Add a new plugin. Emacs 30 or later has to be
; installed (emacs on the PATH).
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.hello-emacs-lisp
Name=Hello (Emacs Lisp)
Description=A command, an event, an outline, a completion and a smart indent written in Emacs Lisp.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
DocumentOpen=opened.el
DocumentOpen.Label=Count the opens (Emacs Lisp)
Outline=outline.el
Outline.Label=Markdown headings (Emacs Lisp sample)
Complement=complement.el
Complement.Label=Hello words (Emacs Lisp sample)
SmartIndent=indent.el
SmartIndent.Label=Indent 4 spaces after a colon (Emacs Lisp sample)

[Command]
C[1]=command.el
C[1].Label=Insert a greeting (Emacs Lisp)

[Option]
O[1].Section=Hello
O[1].Key=Greeting
O[1].Label=Greeting
O[1].Type=Str
O[1].Default=Hello

[Wsh]
; Keep the process. The jack SmartIndent is called by a key press and needs it.
UseCache=1
