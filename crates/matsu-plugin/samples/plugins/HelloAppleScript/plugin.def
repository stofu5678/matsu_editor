; Sample plugin whose handlers run on AppleScript (ADR-0026, PR 10; macOS only): a command, an event, and
; the jacks Outline, Complement and SmartIndent. Put the folder HelloAppleScript in the folder "plugins"
; next to matsu.ini, then use Common settings > Plugin > Add a new plugin. macOS has osascript, so
; nothing has to be installed. On Windows and Linux its handlers do not run.
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.hello-applescript
Name=Hello (AppleScript)
Description=A command, an event, an outline, a completion and a smart indent written in AppleScript.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
DocumentOpen=opened.applescript
DocumentOpen.Label=Count the opens (AppleScript)
Outline=outline.applescript
Outline.Label=Markdown headings (AppleScript sample)
Complement=complement.applescript
Complement.Label=Hello words (AppleScript sample)
SmartIndent=indent.applescript
SmartIndent.Label=Indent 4 spaces after a colon (AppleScript sample)

[Command]
C[1]=command.applescript
C[1].Label=Insert a greeting (AppleScript)

[Option]
O[1].Section=Hello
O[1].Key=Greeting
O[1].Label=Greeting
O[1].Type=Str
O[1].Default=Hello

[Wsh]
; Keep the process. The jack SmartIndent is called by a key press and needs it.
UseCache=1
