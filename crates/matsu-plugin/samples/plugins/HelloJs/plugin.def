; Sample plugin for the settings page (ADR-0026). Its handlers run on the QuickJS of matsu-script.
; Put the folder HelloJs in the folder "plugins" next to matsu.ini, then use
; 共通設定 > プラグイン > 新規プラグインを追加.
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.hello-js
Name=Hello (JavaScript)
Description=Writes a greeting after a file is opened, and has one command.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
DocumentOpen=opened.js
DocumentOpen.Label=Say hello when a file is opened

[Command]
C[1]=command.js
C[1].Label=Insert a greeting

[Option]
O[1].Section=Hello
O[1].Key=Greeting
O[1].Label=Greeting
O[1].Type=Str
O[1].Default=Hello

[Wsh]
UseCache=0
