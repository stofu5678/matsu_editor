; Sample plugin for the completion jacks (ADR-0026, PR 8). Its handlers run on the QuickJS of matsu-script.
; Put the folder HelloComplement in the folder "plugins" next to matsu.ini, add and enable it in
; 共通設定 > プラグイン. ComplementGlobal adds a candidate to the completion of every document type;
; Complement adds candidates to the types whose 「入力補完機能の種類」 (タイプ別設定 > 支援) is this plugin's.
; Open the completion with Ctrl+Space after a word.
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.complement
Name=Complement (JavaScript)
Description=Adds candidates to the input completion.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
ComplementGlobal=global.js
Complement=typed.js
Complement.Label=Hello 補完 (JavaScript)

; The completion jacks are called by a key, so the plugin must stay (resident).
[Wsh]
UseCache=1
