; Sample plugin whose handlers run on the user's Perl (ADR-0026, PR 10): a command, an event, and
; the jacks Outline, Complement and SmartIndent. Put the folder HelloPerl in the folder "plugins"
; next to matsu.ini, then use Common settings > Plugin > Add a new plugin. Perl has to be
; installed.
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.hello-perl
Name=Hello (Perl)
Description=A command, an event, an outline, a completion and a smart indent written in Perl.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
DocumentOpen=opened.pl
DocumentOpen.Label=Count the opens (Perl)
Outline=outline.pl
Outline.Label=Markdown headings (Perl sample)
Complement=complement.pl
Complement.Label=Hello words (Perl sample)
SmartIndent=indent.pl
SmartIndent.Label=Indent 4 spaces after a colon (Perl sample)

[Command]
C[1]=command.pl
C[1].Label=Insert a greeting (Perl)

[Option]
O[1].Section=Hello
O[1].Key=Greeting
O[1].Label=Greeting
O[1].Type=Str
O[1].Default=Hello

[Wsh]
; Keep the process. The jack SmartIndent is called by a key press and needs it.
UseCache=1
