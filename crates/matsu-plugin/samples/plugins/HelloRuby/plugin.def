; Sample plugin whose handlers run on the user's Ruby (ADR-0026, PR 10): a command, an event, and
; the jacks Outline, Complement and SmartIndent. Put the folder HelloRuby in the folder "plugins"
; next to matsu.ini, then use Common settings > Plugin > Add a new plugin. Ruby has to be
; installed.
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.hello-ruby
Name=Hello (Ruby)
Description=A command, an event, an outline, a completion and a smart indent written in Ruby.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
DocumentOpen=opened.rb
DocumentOpen.Label=Count the opens (Ruby)
Outline=outline.rb
Outline.Label=Markdown headings (Ruby sample)
Complement=complement.rb
Complement.Label=Hello words (Ruby sample)
SmartIndent=indent.rb
SmartIndent.Label=Indent 4 spaces after a colon (Ruby sample)

[Command]
C[1]=command.rb
C[1].Label=Insert a greeting (Ruby)

[Option]
O[1].Section=Hello
O[1].Key=Greeting
O[1].Label=Greeting
O[1].Type=Str
O[1].Default=Hello

[Wsh]
; Keep the process. The jack SmartIndent is called by a key press and needs it.
UseCache=1
