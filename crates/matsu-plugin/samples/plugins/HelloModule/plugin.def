; Sample plugin whose handlers are an ES module (.mjs) and a TypeScript file (.ts), run on the user's
; Node.js (ADR-0026, PR 10). Put the folder HelloModule in the folder "plugins" next to matsu.ini, then use
; Common settings > Plugin > Add a new plugin. Node.js 22.18 or later (23.6 or later on the 23 line) has to be
; installed: the .ts handler needs it to strip the types.
;
; A module handler exports a function as `default`. The module is loaded once, when the process starts; the
; function is called for each call (the arguments are `Plugin.args`). It imports the other files of this folder,
; with their extension; packages and files outside this folder cannot be imported.
[Plugin]
Id=io.github.stofu5678.matsu-editor.sample.hello-module
Name=Hello (ES module and TypeScript)
Description=A command and an outline written as an ES module and as TypeScript.
Author=MATSU Editor
Version=1.0.0.0
Url=https://github.com/stofu5678/matsu_editor
Type=wsh

[Plug]
DocumentOpen=opened.mjs
DocumentOpen.Label=Count the opens (ES module)
Outline=outline.ts
Outline.Label=Markdown headings (TypeScript sample)

[Command]
C[1]=command.mjs
C[1].Label=Insert a greeting (ES module)

[Option]
O[1].Section=Hello
O[1].Key=Greeting
O[1].Label=Greeting
O[1].Type=Str
O[1].Default=Hello

[Wsh]
; Keep the process: the modules are loaded once, and the next call does not start Node.js again.
UseCache=1
